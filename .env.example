# =========================================================================
# CardioCare AI - Root Environment Template
# Duplicate this file to .env in production / local dev and provide values
# =========================================================================

# Server configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (Local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/cardiocare_db

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Primary AI Provider - Google Gemini API (Eligible Free-Tier Model)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional Fallback AI Provider - Groq Cloud API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Notification & Email Services (SMTP - Optional, Mocked in Development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password_here
SMTP_FROM=CardioCare AI <notifications@cardiocare.ai>

# Client-side API URL
VITE_API_URL=http://localhost:5000/api
